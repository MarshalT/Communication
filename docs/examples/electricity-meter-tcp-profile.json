{
  "device": {
    "id": "meter-tcp-1",
    "model": "electricity-meter",
    "custom": {
      "energyAddress": "0",
      "energyQuantity": "2",
      "energyScale": "0.01",
      "energyByteOrder": "UInt32BE"
    }
  },
  "transport": {
    "type": "tcp",
    "host": "127.0.0.1",
    "port": 502,
    "connectTimeoutMs": 3000,
    "readTimeoutMs": 1000,
    "writeTimeoutMs": 1000,
    "bufferSize": 4096
  },
  "protocol": {
    "type": "modbus-tcp",
    "station": 1
  },
  "retry": {
    "count": 2,
    "timeoutMs": 1000,
    "delayMs": 100,
    "exponentialBackoff": true
  }
}
